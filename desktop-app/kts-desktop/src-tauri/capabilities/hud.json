{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hud",
  "description": "Capabilities for the dictation/screen-record HUD floating window",
  "windows": ["dictation_hud"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-get-hud-state",
    "allow-hide-hud",
    "allow-stop-dictation",
    "allow-pause-dictation",
    "allow-resume-dictation",
    "allow-stop-screen-record",
    "allow-pause-screen-record",
    "allow-resume-screen-record",
    "allow-start-screen-record",
    "allow-discard-hud",
    "allow-show-hud-result",
    "allow-place-hud-after-resize",
    "allow-mark-hud-moved-by-user",
    "allow-focus-hud",
    "allow-hud-chat-mic-available",
    "allow-start-hud-chat-mic",
    "allow-stop-hud-chat-mic",
    "allow-copy-text-to-clipboard",
    "allow-run-text-action",
    "allow-insert-text-result",
    "allow-get-text-actions-config"
  ]
}
